# Environment Configuration for Infrastructure Project Intelligence Agent
# Copy this file to .env and adjust variables as needed

# Data Cutoff Date for Schedule Analysis (ISO 8601 YYYY-MM-DD)
DATA_CUTOFF_DATE=2026-08-20

# Risk Thresholds
CRITICAL_FLOAT_DAYS=0
DELAY_THRESHOLD_LOW_DAYS=5
DELAY_THRESHOLD_HIGH_DAYS=15
COST_OVERRUN_THRESHOLD_PCT=10.0

# Optional External LLM Integration (System operates locally with deterministic engine if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=local
